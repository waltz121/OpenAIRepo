@{
    ViewData["Title"] = "Search";
}

@using ChatBot.Models.ViewModels
@model SearchViewModel

<div class="Search">
    <h1>Mercola Vector Search</h1>
    <form asp-controller="Search" asp-action="Index" method="post">
        <input type="text" id="search" name="SearchText" placeholder="Search" value="@Model.SearchText" />
        <button type="submit" id="searchButton">Search</button>
        <span asp-validation-for="SearchText" class="validation-error"></span>
    </form>
    <div id="results">
        <ul id="resultsList">
            @foreach (var item in Model.searchResults)
            {
                <li class="resultItem">
                    <div class="Result_Url">
                        <a href="@item.Url">@item.Url</a>
                    </div>
                    <div class="Result_Title">
                        <a href="@item.Url">@item.Title</a>
                    </div>
                    <div class="Result_Description">
                        <p>@item.Description</p>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>

@* Code for enabling to use enter key for post submit *@
<script>
    $(document).ready(function () {
        $("#search").keyup(function (event) {
            if (event.keyCode === 13) {
                $("#searchButton").click();
            }
        });
    });
</script>
