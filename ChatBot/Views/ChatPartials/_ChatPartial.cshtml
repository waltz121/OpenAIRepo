@using ChatBot.Models.ViewModels
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model ChatViewModel
<div class="chat">
    <div class="chat-title">
        <h1>Mercola Customer Service</h1>
        <h2>Chat Bot Assistant</h2>
        <figure class="avatar">
            <img src="images/customer-service.svg" />
        </figure>
    </div>


    @using (Html.BeginForm("SendMessage", "Home", FormMethod.Post))
    {
        <div class="message-box">
            @* <textarea type="text" class="message-input" placeholder="Type message..."></textarea> *@
            @Html.TextAreaFor(model => model.TxtMessage, new { @class = "message-input", @placeholder = "Type message..." })
            <button type="submit" class="message-submit" value="Submit">Send</button>
        </div>
    }


</div>