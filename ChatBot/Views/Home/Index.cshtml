<div class="chat">
    <div class="chat-title">
        <h1>Mercola Customer Service</h1>
        <h2>Chat Bot Assistant</h2>
        <figure class="avatar">
            <img src="images/customer-service.svg" />
        </figure>
    </div>

    <div class="messages">
        <div class="messages-content">
        </div>
    </div>
    <div class="message-box">
        <textarea type="text" class="message-input" placeholder="Type message..."></textarea>

        <button type="submit" class="message-submit" value="Submit">Send</button>
    </div>
</div>

<div class="bg"></div>