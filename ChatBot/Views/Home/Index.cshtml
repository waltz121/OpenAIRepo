@using ChatBot.Models.ViewModels
@{
    ViewData["Title"] = "Home Page";
}

@model ChatViewModel

@* @{
    await Html.RenderPartialAsync("/Views/ChatPartials/_ChatPartial.cshtml", Model);
} *@

<div class="chat">
    <div class="chat-title">
        <h1>Mercola Customer Service</h1>
        <h2>Chat Bot Assistant</h2>
        <figure class="avatar">
            <img src="images/customer-service.svg" />
        </figure>
    </div>

    @Html.Raw(Model.Content);

    <form asp-action="SendMessage" method="post">
        <div class="message-box">
            <textarea asp-for="TxtMessage" class="message-input" placeholder="Type message..."></textarea>
            <button type="submit" class="message-submit" value="Submit">Send</button>
        </div>
    </form>
</div>

<div class="bg"></div>